<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VaultLock" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.VaultLock.Splash">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
    <style name="Theme.VaultLock.Lock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
